# ── Server ─────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Get a free cluster at https://cloud.mongodb.com
MONGO_URI=url

# ── Auth ─────────────────────────────────────────────────────────────────────
# Any long random string, e.g.: openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_secret

# ── Frontend URL (CORS) ───────────────────────────────────────────────────────
# On Render, set this to your Vercel deployment URL.
# Comma-separate multiple origins if needed:
#   FRONTEND_URL=https://reon.vercel.app,https://reon-git-main-yourname.vercel.app
FRONTEND_URL=http://localhost:3000

# ── Cloudinary (profile pictures) ────────────────────────────────────────────
# Sign up at https://cloudinary.com (free tier is fine)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Metered Video (required for voice/video calls) ───────────────────────────
# Sign up free at https://dashboard.metered.ca/signup
# METERED_DOMAIN  → your app's subdomain, e.g.  myapp.metered.live
# METERED_SECRET_KEY → from Dashboard → Settings → Secret Key
METERED_DOMAIN=yourapp.metered.live
METERED_SECRET_KEY=
